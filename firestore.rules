rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is a teacher (admin role)
    function isTeacher() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    
    // Helper function to get conversation and check if user is participant
    function isParticipant(conversationId) {
      let conversation = get(/databases/$(database)/documents/conversations/$(conversationId));
      return isAuthenticated() && request.auth.uid in conversation.data.participantIds;
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone authenticated can read all users
      allow read: if isAuthenticated();
      
      // Users can only create their own profile
      allow create: if isAuthenticated() && isOwner(userId);
      
      // Users can update their own profile, or teachers can update any profile (for moderation)
      allow update: if isAuthenticated() && 
                     (isOwner(userId) || isTeacher());
      
      // Only teachers can delete profiles (for moderation)
      allow delete: if isTeacher();
    }
    
    // Posts collection
    match /posts/{postId} {
      // Anyone authenticated can read posts
      allow read: if isAuthenticated();
      
      // Anyone authenticated can create posts (must be the author)
      allow create: if isAuthenticated() && 
                     request.resource.data.authorId == request.auth.uid;
      
      // Author can update their own posts, or teachers can update any post (for moderation)
      allow update: if isAuthenticated() && 
                     (resource.data.authorId == request.auth.uid || isTeacher());
      
      // Author can delete their own posts, or teachers can delete any post (for moderation)
      allow delete: if isAuthenticated() && 
                     (resource.data.authorId == request.auth.uid || isTeacher());
    }
    
    // Conversations collection
    match /conversations/{conversationId} {
      // Participants can read conversations, or teachers can read all (for safety monitoring)
      allow read: if isAuthenticated() && 
                   (request.auth.uid in resource.data.participantIds || isTeacher());
      
      // Anyone authenticated can create conversations (must be a participant)
      allow create: if isAuthenticated() && 
                     request.auth.uid in request.resource.data.participantIds &&
                     request.resource.data.participantIds.size() == 2;
      
      // Participants can update conversations, or teachers can update any (for moderation)
      allow update: if isAuthenticated() && 
                     (request.auth.uid in resource.data.participantIds || isTeacher());
      
      // Participants can delete conversations, or teachers can delete any (for moderation)
      allow delete: if isAuthenticated() && 
                     (request.auth.uid in resource.data.participantIds || isTeacher());
    }
    
    // Messages collection
    match /messages/{messageId} {
      // Participants can read messages, or teachers can read all (for safety monitoring)
      allow read: if isAuthenticated() && 
                   (resource.data.conversationId != null &&
                    (isParticipant(resource.data.conversationId) || isTeacher()));
      
      // Only participants can create messages (must be the sender)
      allow create: if isAuthenticated() && 
                     request.resource.data.conversationId != null &&
                     request.resource.data.senderId == request.auth.uid &&
                     isParticipant(request.resource.data.conversationId);
      
      // Sender can update their own messages, or teachers can update any (for moderation)
      allow update: if isAuthenticated() && 
                     (resource.data.senderId == request.auth.uid || isTeacher());
      
      // Sender can delete their own messages, or teachers can delete any (for moderation)
      allow delete: if isAuthenticated() && 
                     (resource.data.senderId == request.auth.uid || isTeacher());
    }
  }
}

